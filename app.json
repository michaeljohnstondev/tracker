{
  "expo": {
    "name": "Tracker",
    "slug": "tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tracker",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#001020",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#001020"
      },
      "package": "com.bigvibestudiosadmin.tracker",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "cba1bbd2-ea1b-43ba-9300-586e38408a48"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/cba1bbd2-ea1b-43ba-9300-586e38408a48"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      "expo-build-properties",
      "@react-native-firebase/messaging"
    ]
  }
}
