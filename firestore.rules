rules_version = '2';

// Data model
// ----------
// users/{uid}                 profile shown to people you share with
// users/{uid}/private/push    FCM token — nobody else's business
// nodes/{nodeId}              a shared node, carrying rootId
// memberships/{rootId}_{uid}  one doc per person per shared tree
// invites/{code}              short random code -> rootId
// shares/{rootId}_{email}     an invitation addressed to one person
// reminders/{id}              a pending alarm, self-contained
//
// Everything in the app is a node, and sharing attaches to a node and takes
// its subtree with it. Each shared node stores `rootId` — the node that was
// actually shared — so "may this person read this node" is a single
// membership lookup. Rules cannot walk an ancestor chain of unknown length,
// which is exactly why that field is denormalised onto every node.
//
// Membership is its own collection rather than an array on the root, because a
// joiner cannot read the root before they belong to it, and so could never
// compute "existing members plus me" to write back. They create their own
// membership row and the rules re-check the invite code server-side. Knowing
// a code is the entire authorization to join.
//
// No Cloud Functions are needed for any of this: it all works on the free
// Spark plan.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function membershipId(rootId) {
      return rootId + '_' + uid();
    }

    function isMember(rootId) {
      return signedIn()
        && exists(/databases/$(database)/documents/memberships/$(membershipId(rootId)));
    }

    // The exists() guard is not belt and braces. get() on a missing document
    // is an evaluation error, not a false — and an error aborts the whole
    // expression rather than falling through to the next || branch. A tree
    // whose root has been deleted would therefore fail every check that
    // mentions ownership, including ones it isn't part of.
    function ownsTree(rootId) {
      return signedIn()
        && exists(/databases/$(database)/documents/trees/$(rootId)/nodes/$(rootId))
        && get(/databases/$(database)/documents/trees/$(rootId)/nodes/$(rootId)).data.ownerUid == uid();
    }

    // An invite code is the shared secret; holding one that points at this
    // tree is what authorizes joining it.
    //
    // Joining by email carries no code at all, so the field has to be checked
    // for before it's read: naming a key that isn't there is an evaluation
    // error, which would take down the surrounding expression with it.
    function inviteGrants(rootId) {
      return 'usedInviteCode' in request.resource.data
        && exists(/databases/$(database)/documents/invites/$(request.resource.data.usedInviteCode))
        && get(/databases/$(database)/documents/invites/$(request.resource.data.usedInviteCode)).data.rootId == rootId;
    }

    // Or you were invited by email. The invitation is keyed by the address it
    // was sent to, so the check is a path lookup against the signed-in user's
    // own verified email — no directory of users to search, and nothing that
    // would let one account discover another.
    function invitedByEmail(rootId) {
      return request.auth.token.email != null
        && exists(/databases/$(database)/documents/shares/$(rootId + '_' + request.auth.token.email));
    }

    // Readable by any signed-in user so a shared tree can show who ticked
    // something off; writable only by the person it describes.
    match /users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && uid() == userId;

      // Push tokens. Subcollections don't inherit the rule above, so this has
      // to be stated separately. Cloud Functions use the Admin SDK and bypass
      // rules, so they can still read tokens in order to send.
      match /private/{docId} {
        allow read, write: if signedIn() && uid() == userId;
      }

      // A list of the trees you made, so they can be found again when the
      // membership pointing at them is gone.
      //
      // This replaces a collection-group read of nodes filtered on ownerUid,
      // which could not be made to work: written as a plain field comparison
      // it errored on any node predating that field — and an error denies the
      // whole request, which made shared lists unreadable — while the guarded
      // form that can't error is no longer something Firestore can prove
      // against the query's own filter. A per-user list needs neither. It
      // matches one path, reads nothing but its own documents, and has no way
      // to fail.
      match /trees/{treeId} {
        allow read, write: if signedIn() && uid() == userId;
      }
    }

    // The tree's root is in the path, so the rule reads it from there rather
    // than from document data. That matters: reading a whole tree is then a
    // plain collection read, and Firestore evaluates query rules against the
    // query rather than its results — a rule depending on document data can
    // never be proven from a filter, and the read is denied outright.
    match /trees/{rootId}/nodes/{nodeId} {
      allow read, update, delete: if isMember(rootId);

      // Creating the root is what establishes a tree, so it cannot require
      // membership: the membership rule reads the root to confirm ownership,
      // and requiring each to exist before the other deadlocks — nothing gets
      // written and sharing silently does nothing. Claiming a root is safe on
      // its own; the id is freshly generated, and everything after it needs
      // the membership that only the owner can then create.
      allow create: if signedIn()
        && request.resource.data.ownerUid == uid()
        && (nodeId == rootId || isMember(rootId));
    }

    match /memberships/{docId} {
      allow read: if signedIn()
        && (resource.data.uid == uid() || isMember(resource.data.rootId));

      // You may only ever create your own membership, at the canonical id, and
      // only if you own the tree or hold a valid invite to it.
      allow create: if signedIn()
        && request.resource.data.uid == uid()
        && docId == membershipId(request.resource.data.rootId)
        // Cheapest and safest first: an email invitation is one exists() and
        // cannot error, while ownership has a document to read.
        && (invitedByEmail(request.resource.data.rootId)
            || ownsTree(request.resource.data.rootId)
            || inviteGrants(request.resource.data.rootId));

      // Leaving is deleting your own row; an owner may also remove someone.
      allow delete: if signedIn()
        && (resource.data.uid == uid() || ownsTree(resource.data.rootId));
    }

    // An invitation addressed to one person, keyed {rootId}_{email}.
    //
    // Readable only by the address it was sent to, and matched against the
    // verified email in their sign-in token — so an invitation cannot be
    // claimed by anyone else, and there is no way to search for who has an
    // account.
    match /shares/{docId} {
      allow read: if signedIn() && resource.data.email == request.auth.token.email;

      // Update as well as create: setDoc on an invitation that already exists
      // is an update, so inviting the same person twice — which is exactly
      // what you do when the first one doesn't seem to have worked — was
      // refused. Nothing can be repointed by it, since the id pins both the
      // tree and the address.
      allow create, update: if signedIn()
        && isMember(request.resource.data.rootId)
        && docId == request.resource.data.rootId + '_' + request.resource.data.email;

      // Cleared by the recipient once they've joined, or withdrawn by anyone
      // already on the tree.
      allow delete: if signedIn()
        && (resource.data.email == request.auth.token.email
            || isMember(resource.data.rootId));
    }

    // Codes are random and unguessable; reading one reveals only a rootId,
    // which is useless on its own since joining still creates a membership
    // that gets re-checked above.
    match /invites/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && isMember(request.resource.data.rootId);
      allow delete: if signedIn() && isMember(resource.data.rootId);
    }

    // A pending alarm. Self-contained on purpose: it carries its own copy of
    // the text and the people to notify, so the sweep never reads the node it
    // came from — which is what lets an alarm work on a device-local node that
    // was never uploaded.
    match /reminders/{docId} {
      allow read, update, delete: if signedIn()
        && (uid() in resource.data.targetUids
            || (resource.data.listId != null && isMember(resource.data.listId)));

      allow create: if signedIn()
        && uid() in request.resource.data.targetUids
        && request.resource.data.fireAt is number;
    }
  }
}
